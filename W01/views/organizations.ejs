<%- include('partials/header') %>

<h1>Partner Organizations</h1>
<p>Nonprofits and community groups hosting service projects right now.</p>

<div class="grid">
  <% organizations.forEach((organization) => { %>
    <div class="card">
      <% if (organization.image_url) { %>
        <img src="<%= organization.image_url %>" alt="<%= organization.organization_name %> logo">
      <% } %>
      <h2><%= organization.organization_name %></h2>
      <p><%= organization.description %></p>
      <p>Contact: <a href="mailto:<%= organization.contact_email %>"><%= organization.contact_email %></a></p>
    </div>
  <% }); %>
</div>

<%- include('partials/footer') %>
