<%- include('partials/header') %>

<main class="container" id="main">
  <section class="hero">
    <h2>Connect with service opportunities near you</h2>
    <p>
      ServiceConnect brings volunteers and local organizations together.
      Browse organizations, discover active projects, and find the cause
      that fits your time and skills.
    </p>
    <a class="button" href="/categories">Browse categories</a>
  </section>

  <section class="page-intro">
    <h2>How it works</h2>
  </section>

  <div class="category-grid">
    <article class="category-card">
      <h3>1. Find an organization</h3>
      <p>Explore verified nonprofits and community groups in your area.</p>
    </article>

    <article class="category-card">
      <h3>2. Pick a project</h3>
      <p>Review open service projects and the time commitment each one needs.</p>
    </article>

    <article class="category-card">
      <h3>3. Get involved</h3>
      <p>Sign up, show up, and track the impact you make over time.</p>
    </article>
  </div>
</main>

<%- include('partials/footer') %>
