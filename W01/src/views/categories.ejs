<%- include('partials/header') %>

<h1>Service Project Categories</h1>
<p>Find a way to give back to your community.</p>

<p><a href="/new-category" class="button">Add a new category</a></p>

<div class="grid">
  <% categories.forEach((category) => { %>
    <div class="card">
      <h2><a href="/category/<%= category.category_id %>"><%= category.category_name %></a></h2>
      <p><%= category.description %></p>
    </div>
  <% }); %>
</div>

<%- include('partials/footer') %>
