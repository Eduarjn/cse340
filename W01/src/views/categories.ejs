<%- include('partials/header') %>

<h1>Service Project Categories</h1>
<p>Find a way to give back to your community.</p>

<div class="grid">
  <% categories.forEach((category) => { %>
    <div class="card">
      <h2><%= category.category_name %></h2>
      <p><%= category.description %></p>
    </div>
  <% }); %>
</div>

