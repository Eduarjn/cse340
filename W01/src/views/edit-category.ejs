<%- include('partials/header') %>

<%# A rejected submission wins over the stored row, so the user gets back what
    they had just typed instead of the old value. %>
<% const name = formData.categoryName ?? category.category_name; %>
<% const description = formData.description ?? category.description; %>

<h1>Edit category</h1>

<div class="card">
  <form action="/edit-category/<%= category.category_id %>" method="post" class="form">
    <div class="form-field">
      <label for="categoryName">Category name <span class="required">*</span></label>
      <input type="text" id="categoryName" name="categoryName"
             value="<%= name %>"
             maxlength="100" required>
    </div>

    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"
                maxlength="500"><%= description %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="button">Save changes</button>
      <a href="/category/<%= category.category_id %>" class="button button-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
