<%- include('partials/header') %>

<h1><%= category.category_name %></h1>

<div class="card">
  <p><%= category.description %></p>
</div>

<h2>Service projects</h2>

<div class="grid">
  <% projects.forEach((project) => { %>
    <div class="card">
      <h3><a href="/project/<%= project.project_id %>"><%= project.title %></a></h3>
      <p>Date: <%= project.date.toISOString().slice(0, 10) %></p>
      <p>Location: <%= project.location %></p>
    </div>
  <% }); %>
</div>

<div class="form-actions">
  <a href="/edit-category/<%= category.category_id %>" class="button">Edit this category</a>
  <a href="/categories" class="button button-secondary">Back to categories</a>
</div>

<%- include('partials/footer') %>
