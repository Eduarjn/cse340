<%- include('partials/header') %>

<h1>Create an account</h1>

<div class="card">
  <p>
    An account lets you keep track of the projects you are interested in.
    Administrator access is granted separately by the ServiceConnect team.
  </p>

  <%# The 6 character minimum is only checked on the server, so the rule can
      be tested from this form. %>
  <form action="/register" method="post" class="form">
    <div class="form-field">
      <label for="name">Name <span class="required">*</span></label>
      <input type="text" id="name" name="name"
             value="<%= formData.name || '' %>"
             maxlength="100" required>
    </div>

    <div class="form-field">
      <label for="email">Email <span class="required">*</span></label>
      <input type="email" id="email" name="email"
             value="<%= formData.email || '' %>"
             maxlength="255" autocomplete="email" required>
    </div>

    <div class="form-field">
      <label for="password">Password <span class="required">*</span></label>
      <input type="password" id="password" name="password"
             autocomplete="new-password" required>
      <p class="hint">At least 6 characters.</p>
    </div>

    <div class="form-actions">
      <button type="submit" class="button">Create account</button>
      <a href="/login" class="button button-secondary">I already have one</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
