<%- include('partials/header') %>

<h1>Add a new category</h1>

<div class="card">
  <%# No minlength here on purpose: the 3 character minimum is checked by the
      server, so the server-side validation can be tested from this form. %>
  <form action="/new-category" method="post" class="form">
    <div class="form-field">
      <label for="categoryName">Category name <span class="required">*</span></label>
      <input type="text" id="categoryName" name="categoryName"
             value="<%= formData.categoryName || '' %>"
             maxlength="100" required>
    </div>

    <div class="form-field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="4"
                maxlength="500"><%= formData.description || '' %></textarea>
    </div>

    <div class="form-actions">
      <button type="submit" class="button">Add category</button>
      <a href="/categories" class="button button-secondary">Cancel</a>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
