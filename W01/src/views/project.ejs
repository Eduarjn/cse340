<%- include('partials/header') %>

<h1><%= project.title %></h1>

<div class="card">
  <p><%= project.description %></p>
  <p>Date: <%= project.date.toISOString().slice(0, 10) %></p>
  <p>Location: <%= project.location %></p>
  <p>
    Hosted by
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>
  <ul class="tags" aria-label="Categories">
    <% categories.forEach((category) => { %>
      <li>
        <a class="tag" href="/category/<%= category.category_id %>"><%= category.category_name %></a>
      </li>
    <% }); %>
  </ul>

  <p class="volunteer-count">
    <% if (volunteers.length === 0) { %>
      No volunteers yet. Be the first.
    <% } else if (volunteers.length === 1) { %>
      1 volunteer has signed up.
    <% } else { %>
      <%= volunteers.length %> volunteers have signed up.
    <% } %>
  </p>
</div>

<%# Volunteering is only offered to someone who is signed in. An anonymous
    visitor sees an invitation to sign in instead. %>
<% if (isLoggedIn) { %>
  <div class="card volunteer-card">
    <% if (signedUp) { %>
      <p class="volunteer-yes">You are volunteering for this project.</p>
      <form action="/remove-volunteer/<%= project.project_id %>" method="post">
        <button type="submit" class="button button-secondary">
          Remove me as a volunteer
        </button>
      </form>
    <% } else { %>
      <p>Interested in helping with this project?</p>
      <form action="/volunteer/<%= project.project_id %>" method="post">
        <button type="submit" class="button">Volunteer for this project</button>
      </form>
    <% } %>
  </div>
<% } else { %>
  <div class="card volunteer-card">
    <p><a href="/login">Sign in</a> to volunteer for this project.</p>
  </div>
<% } %>

<div class="form-actions">
  <% if (user && user.role_name === 'admin') { %>
    <a href="/edit-project/<%= project.project_id %>" class="button">Edit this project</a>
    <a href="/assign-categories/<%= project.project_id %>" class="button">Update categories</a>
  <% } %>
  <a href="/projects" class="button button-secondary">Back to upcoming projects</a>
</div>

<%- include('partials/footer') %>
