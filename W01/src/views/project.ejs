<%- include('partials/header') %>

<h1><%= project.title %></h1>

<div class="card">
  <p><%= project.description %></p>
  <p>Date: <%= project.date.toISOString().slice(0, 10) %></p>
  <p>Location: <%= project.location %></p>
  <p>
    Hosted by
    <a href="/organization/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>
  <ul class="tags" aria-label="Categories">
    <% categories.forEach((category) => { %>
      <li>
        <a class="tag" href="/category/<%= category.category_id %>"><%= category.category_name %></a>
      </li>
    <% }); %>
  </ul>
</div>

<a href="/projects" class="button">Back to upcoming projects</a>

<%- include('partials/footer') %>
